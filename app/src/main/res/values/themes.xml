<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the visuals once the activity starts; this base just
         keeps the system UI quiet and supports the splash screen API. -->
    <style name="Theme.MigsScan" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="postSplashScreenTheme">@style/Theme.MigsScan.Post</item>
    </style>

    <style name="Theme.MigsScan.Post" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
